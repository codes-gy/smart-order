# .env 파일 예시 — 실제 값은 backend/.env(gitignore 대상)에 로컬로만 채워 넣을 것
DB_DRIVER_CLASS_NAME=org.postgresql.Driver
DB_URL=jdbc:postgresql://localhost:5432/smartorder
DB_USERNAME=postgres
DB_PASSWORD=changeme

JWT_SECRET=changeme

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_SERVER=localhost:9092

# 쉼표로 구분해 여러 도메인 지정 가능. prod 배포 시 실제 프론트 도메인으로 반드시 교체할 것.
CORS_ALLOWED_ORIGINS=http://localhost:3000

APPLE_CLIENT_ID=
